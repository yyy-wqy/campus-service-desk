# 本文件只说明可配置项，不包含真实密钥。
# PowerShell 中可按 README 的方法设置这些环境变量。
DJANGO_SECRET_KEY=replace-with-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# 本地开发：只在终端打印邮件，不实际发信。
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=campus-service@localhost

# 将来部署真实邮件时才配置 SMTP；授权码只放环境变量中。
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=sender@example.com
# DJANGO_EMAIL_HOST_PASSWORD=replace-with-app-password
# DJANGO_EMAIL_USE_TLS=True
# DJANGO_EMAIL_USE_SSL=False

